# Default is a read-only sample workspace. No database required.
DEMO_MODE=true
# Connected mode: set false, fill these values, and set HISTORY_FILENAME=history.sqlite3.
FLASK_SECRET_KEY=
SQLSERVER_HOST=
SQLSERVER_DATABASE=
# SQL Server-side path, NOT the web container filesystem. Linux example:
AUDIT_FILE_PATTERN=/var/opt/mssql/audit/*.sqlaudit
HISTORY_FILENAME=demo.sqlite3
# true when serving the web app over HTTPS (false for local HTTP).
COOKIE_SECURE=false
